{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/oauth-protected-resource" }
  ],
  "headers": [
    {
      "source": "/api/mcp",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, GET, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Mcp-Session-Id" },
        { "key": "Access-Control-Expose-Headers", "value": "Mcp-Session-Id, WWW-Authenticate" }
      ]
    }
  ]
}
